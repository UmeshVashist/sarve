{
  "name": "sarve-project",
  "version": "1.0.0",
  "description": "Full-stack Sarve Portal in React and Node.js with SQLite / Cloudflare D1 integration",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "sarve",
    "prisoner-survey",
    "cloudflare-d1",
    "react",
    "nodejs"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
